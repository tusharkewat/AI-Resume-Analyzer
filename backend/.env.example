# Backend Configuration
PROJECT_NAME="AI Resume Analyzer & Job Matcher"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"  # Use "production" in deployed environments

# Security
# In production, SECRET_KEY must be >= 32 characters and explicitly configured.
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=15
RATE_LIMIT_ANALYSIS_PER_MINUTE=20

# Database
# Local SQLite:
DATABASE_URL="sqlite:///./resume_matcher.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/resume_matcher"
AUTO_RUN_MIGRATIONS=false

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Upload Constraints
MAX_FILE_SIZE_BYTES=5242880

# Optional AI LLM Provider ("none", "gemini", "openai")
LLM_PROVIDER="none"
LLM_API_KEY=""
LLM_MODEL=""
